# Environment Configuration for New RMS 2026

# Application Port
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://rms_admin:rms_password_secure_2026@localhost:5432/new_rms_db?schema=public"

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# NextAuth / JWT Secret
NEXTAUTH_SECRET="your-super-secure-secret-key-change-this-in-production-2026"
NEXTAUTH_URL="http://localhost:3000"

# Google Workspace SSO (OAuth 2.0)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# LINE Official Account & Messaging API
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""

# MinIO / S3 Object Storage
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minio_admin"
S3_SECRET_KEY="minio_password_2026"
S3_BUCKET_NAME="new-rms-documents"

# Geofencing College Location (CRiC Campus Coordinates)
COLLEGE_LATITUDE=19.9072
COLLEGE_LONGITUDE=99.8325
COLLEGE_GEOFENCE_RADIUS_METERS=200
COLLEGE_WIFI_SSID="CRIC-STAFF,CRIC-WiFi"
