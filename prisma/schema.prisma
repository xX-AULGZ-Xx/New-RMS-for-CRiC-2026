datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  EXECUTIVE        // ผู้อำนวยการ / รองผู้อำนวยการ
  HEAD_DEPARTMENT  // หัวหน้าแผนกวิชา / หัวหน้างาน
  TEACHER          // ครูผู้สอน / ครูที่ปรึกษา
  STAFF            // เจ้าหน้าที่ธุรการ / สารบรรณ / การเงิน
  STUDENT          // นักเรียน / นักศึกษา
  PARENT           // ผู้ปกครอง
}

enum DocStatus {
  DRAFT
  ROUTING
  ENDORSED
  APPROVED
  REJECTED
  ARCHIVED
}

enum DocPriority {
  NORMAL           // ปกติ
  URGENT           // ด่วน
  VERY_URGENT      // ด่วนมาก
  MOST_URGENT      // ด่วนที่สุด
}

enum AttendanceStatus {
  PRESENT          // มา
  LATE             // สาย
  LEAVE            // ลา
  ABSENT           // ขาด
}

enum AttendanceType {
  FLAG_CEREMONY    // หน้าเสาธง
  HOMEROOM         // โฮมรูม
  PERIOD_CLASS     // รายคาบ
}

enum LeaveType {
  SICK             // ลาป่วย
  BUSINESS         // ลากิจ
  VACATION         // ลาพักผ่อน
  OFFICIAL_DUTY    // ไปราชการ / อบรม
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  citizenId         String?             @unique
  passwordHash      String
  fullName          String
  phone             String?
  role              Role                @default(TEACHER)
  pinHash           String?             // สำหรับ PIN 6 หลักยืนยันลายเซ็น
  signatureImg      String?             @db.Text // Data URI หรือ URL ภาพลายเซ็น
  avatarUrl         String?             @db.Text
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  personnelProfile  PersonnelProfile?
  studentProfile    StudentProfile?
  documentsCreated  Document[]
  signatures        DocumentSignature[]
  routingsAssigned  DocumentRouting[]
}

model Department {
  id          String             @id @default(uuid())
  code        String             @unique // เช่น DEPT-IT, DEPT-ACC
  name        String             // แผนกวิชาเทคโนโลยีสารสนเทศ
  headName    String?
  personnel   PersonnelProfile[]
  classrooms  Classroom[]
  courses     Course[]
  templates   DocumentTemplate[]
  createdAt   DateTime           @default(now())
}

model Classroom {
  id           String           @id @default(uuid())
  code         String           @unique // เช่น IT101, AC201
  name         String           // เช่น สส. 1/1, ทส. 2/1
  level        String           // ปวช.1, ปวช.2, ปวช.3, ปวส.1, ปวส.2
  academicYear String           @default("2569")
  departmentId String
  department   Department       @relation(fields: [departmentId], references: [id])
  students     StudentProfile[]
  schedules    ClassSchedule[]
  createdAt    DateTime         @default(now())
}

model PersonnelProfile {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode   String?        @unique
  position       String         // ครูชำนาญการ, รอง ผอ., เจ้าหน้าที่
  departmentId   String
  department     Department     @relation(fields: [departmentId], references: [id])
  timeLogs       StaffTimeLog[]
  leaveRequests  LeaveRequest[]
  createdAt      DateTime       @default(now())
}

model StudentProfile {
  id                String                  @id @default(uuid())
  userId            String                  @unique
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentCode       String                  @unique // รหัสนักเรียน 10-11 หลัก
  classroomId       String
  classroom         Classroom               @relation(fields: [classroomId], references: [id])
  parentPhone       String?
  parentLineId      String?
  attendances       StudentAttendance[]
  periodAttendances ClassPeriodAttendance[]
  scores            CourseScore[]
  createdAt         DateTime                @default(now())
}

model Document {
  id               String              @id @default(uuid())
  docNumber        String?             // เลขที่หนังสือ เช่น วอช. 012/2569
  title            String
  abstractContent  String?             @db.Text
  originalFileUrl  String?             @db.Text
  stampedPdfUrl    String?             @db.Text
  priority         DocPriority         @default(NORMAL)
  status           DocStatus           @default(DRAFT)
  category         String              @default("MEMO") // INBOUND, OUTBOUND, MEMO, ORDER, CIRCULAR
  originOrg        String?                              // หน่วยงานต้นทาง
  receiverOrg      String?                              // หน่วยงานปลายทาง/ผู้รับ
  qrToken          String              @unique @default(uuid())
  creatorId        String
  creator          User                @relation(fields: [creatorId], references: [id])
  routings         DocumentRouting[]
  signatures       DocumentSignature[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model DocumentRouting {
  id           String    @id @default(uuid())
  documentId   String
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  stepOrder    Int
  targetUserId String
  targetUser   User      @relation(fields: [targetUserId], references: [id])
  actionNote   String?   @db.Text // บันทึกเกษียณข้อความ
  isApproved   Boolean   @default(false)
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
}

model DocumentSignature {
  id           String    @id @default(uuid())
  documentId   String
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signerId     String
  signer       User      @relation(fields: [signerId], references: [id])
  signatureUrl String    @db.Text
  signedHash   String    // SHA-256 hash ณ เวลาที่เซ็น
  pinVerified  Boolean   @default(true)
  ipAddress    String?
  signedAt     DateTime  @default(now())
}

model DocumentTemplate {
  id              String       @id @default(uuid())
  code            String       @unique // เช่น TPL-MEMO-001, TPL-ORDER-002
  title           String       // เช่น บันทึกข้อความขออนุมัติจัดโครงการพัฒนาทักษะวิชาชีพ
  category        String       @default("MEMO") // MEMO, OUTBOUND, ORDER, CIRCULAR, FORM
  departmentId    String?
  department      Department?  @relation(fields: [departmentId], references: [id])
  description     String?      @db.Text // คำอธิบายหรือคำแนะนำในการใช้แบบฟอร์ม
  defaultOrigin   String?      // หน่วยงานต้นเรื่อง เช่น แผนกวิชาเทคโนโลยีสารสนเทศ
  defaultReceiver String?      // เรียน เช่น ผู้อำนวยการวิทยาลัยอาชีวศึกษาเชียงราย
  subjectPrefix   String?      // คำขึ้นต้นเรื่อง เช่น ขออนุมัติ..., ขอความอนุเคราะห์...
  bodyContent     String       @db.Text // เนื้อหาแม่แบบ (รองรับ placeholder เช่น {{department}}, {{date}}, {{title}}, {{amount}})
  variablesJson   String?      @db.Text // JSON รายการตัวแปรที่ให้ผู้ใช้กรอกเติมคำในช่องว่าง เช่น ["department", "amount", "targetDate"]
  priority        DocPriority  @default(NORMAL)
  sampleFileUrl   String?      @db.Text
  tags            String?      // แท็กค้นหา เช่น "โครงการ, งบประมาณ, ฝึกงาน, กิจกรรม"
  usageCount      Int          @default(0)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model StudentAttendance {
  id          String           @id @default(uuid())
  studentId   String
  student     StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date        DateTime         @default(now())
  type        AttendanceType   @default(FLAG_CEREMONY)
  status      AttendanceStatus @default(PRESENT)
  source      String           @default("TEACHER_APP") // TEACHER_APP / FINGERPRINT / RFID
  recordedBy  String?
  remarks     String?          @db.Text
  createdAt   DateTime         @default(now())
}

model ClassPeriodAttendance {
  id           String           @id @default(uuid())
  studentId    String
  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseCode   String?
  courseName   String?
  period       Int              // คาบที่ 1-10
  weekNumber   Int              // สัปดาห์ที่ 1-18
  date         DateTime
  status       AttendanceStatus @default(PRESENT)
  teacherId    String?
  remarks      String?          @db.Text
  createdAt    DateTime         @default(now())
}

model StaffTimeLog {
  id          String           @id @default(uuid())
  personnelId String
  personnel   PersonnelProfile @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  timestamp   DateTime         @default(now())
  type        String           // CHECK_IN / CHECK_OUT
  latitude    Float?
  longitude   Float?
  wifiSsid    String?
  isVerified  Boolean          @default(true)
  source      String           @default("SMARTPHONE_GPS")
  createdAt   DateTime         @default(now())
}

model LeaveRequest {
  id          String           @id @default(uuid())
  personnelId String
  personnel   PersonnelProfile @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  leaveType   LeaveType        @default(SICK)
  startDate   DateTime
  endDate     DateTime
  totalDays   Float
  reason      String           @db.Text
  status      String           @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy  String?
  createdAt   DateTime         @default(now())
}

model CourseScore {
  id           String         @id @default(uuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseCode   String         // เช่น 30204-2001
  courseName   String         // เช่น การพัฒนาโปรแกรมบนอุปกรณ์เคลื่อนที่
  academicTerm String         @default("1/2569")
  unit1Score   Float          @default(0)
  unit2Score   Float          @default(0)
  midtermScore Float          @default(0)
  finalScore   Float          @default(0)
  totalScore   Float          @default(0)
  grade        String?        // 4.0, 3.5, 3.0, ... 0
  isStd02Synced Boolean       @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AcademicTerm {
  id            String    @id @default(uuid())
  level         String    // ปวช. หรือ ปวส.
  term          String    // 1 หรือ 2
  academicYear  String    // 2569
  totalWeeks    Int       // 18 หรือ 15
  startDate     DateTime
  endDate       DateTime
  midtermWeek   Int?      @default(9)
  midtermDate   DateTime?
  finalWeek     Int?      @default(18)
  finalDate     DateTime?
  gradeDeadline DateTime?
  status        String    @default("OPEN") // OPEN, EXAM, CLOSED
  note          String?   @db.Text
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([level, term, academicYear])
}

model SystemSetting {
  id        String   @id @default(uuid())
  category  String   // "COLLEGE", "GEOFENCE", "INTEGRATION", "CALENDAR"
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model SmartGateLog {
  id        String   @id @default(uuid())
  userCode  String   // รหัสนักเรียน/บุคลากร
  userName  String
  role      String   // STUDENT, TEACHER, STAFF, VISITOR
  gateName  String   // เช่น ประตูหน้า 1, ประตูข้างหอประชุม
  direction String   // IN, OUT
  timestamp DateTime @default(now())
  rfidCard  String?
  temp      Float?
  imageUrl  String?  @db.Text
}

model SystemBackupLog {
  id         String   @id @default(uuid())
  fileName   String
  fileSizeKb Float
  type       String   // AUTO_DAILY, MANUAL, PRE_UPGRADE
  status     String   // SUCCESS, FAILED
  executedBy String   // Admin or SYSTEM
  createdAt  DateTime @default(now())
}

model ClassSchedule {
  id           String    @id @default(uuid())
  courseCode   String    // เช่น 20204-2001
  courseName   String    // การพัฒนาโปรแกรมบนอุปกรณ์เคลื่อนที่
  classroomId  String    // เช่น ห้อง IT101 (ปวช. 1/1)
  classroom    Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacherName  String    // เช่น อาจารย์สมชาย ปัญญาดี
  teacherId    String?   // User ID if assigned
  dayOfWeek    Int       // 1 = Monday, 2 = Tuesday, 3 = Wednesday, 4 = Thursday, 5 = Friday
  periodStart  Int       // 1 - 10
  periodEnd    Int       // 1 - 10
  roomNumber   String    // เช่น Lab IT 1, ห้อง 421
  colorTheme   String?   @default("cyan") // cyan, purple, emerald, amber, rose, blue
  academicTerm String    @default("1/2569")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CourseScoreWeight {
  id              String   @id @default(uuid())
  courseCode      String   // เช่น 20204-2001
  courseName      String
  academicTerm    String   @default("1/2569")
  affectiveWeight Float    @default(20) // จิตพิสัย / คุณธรรมจริยธรรม
  taskWeight      Float    @default(40) // ภาระงาน / ปฏิบัติการ
  midtermWeight   Float    @default(20) // สอบกลางภาค
  finalWeight     Float    @default(20) // สอบปลายภาค
  totalWeight     Float    @default(100)
  updatedAt       DateTime @updatedAt

  @@unique([courseCode, academicTerm])
}

model TeachingLog {
  id              String    @id @default(uuid())
  courseCode      String
  courseName      String
  classroomId     String?
  weekNumber      Int       // สัปดาห์ที่ 1 - 18
  date            DateTime
  topic           String    // แผนการจัดการเรียนรู้ / หัวข้อเรื่อง
  learningOutcome String?   @db.Text // ผลการจัดการเรียนรู้
  totalStudents   Int       @default(0)
  presentCount    Int       @default(0)
  absentCount     Int       @default(0)
  lateCount       Int       @default(0)
  leaveCount      Int       @default(0)
  problems        String?   @db.Text // ปัญหาและอุปสรรค
  solutions       String?   @db.Text // แนวทางแก้ไข / สอนซ่อมเสริม
  teacherName     String
  teacherId       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Course {
  id              String      @id @default(uuid())
  code            String      @unique // เช่น 20204-2001, 30204-2001
  nameTh          String      // การพัฒนาโปรแกรมบนอุปกรณ์เคลื่อนที่
  nameEn          String?     // Mobile Application Development
  level           String      // ปวช. หรือ ปวส.
  credits         Int         @default(3) // หน่วยกิต เช่น 3
  theoryHours     Int         @default(2) // ทฤษฎี (ท.) เช่น 2
  practiceHours   Int         @default(2) // ปฏิบัติ (ป.) เช่น 2
  totalHours      Int         @default(4) // รวมชั่วโมงต่อสัปดาห์
  category        String      @default("VOCATIONAL_CORE") // GENERAL (สามัญ), VOCATIONAL_CORE (วิชาชีพเฉพาะ), VOCATIONAL_SELECT (วิชาชีพเลือก), PROJECT (โครงการ/ฝึกงาน)
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  description     String?     @db.Text // จุดประสงค์และคำอธิบายรายวิชา
  competency      String?     @db.Text // สมรรถนะรายวิชา
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}
